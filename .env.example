# Copie para .env no ambiente local. Nunca inclua credenciais neste exemplo.
# No EasyPanel, cadastrar os valores na seção de variáveis de ambiente.

APP_URL=http://127.0.0.1:8002

# OpenAI — somente servidor; não usar prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL 16: postgresql://USUARIO:SENHA@HOST:5432/BANCO
DATABASE_URL=

# PostgreSQL local via Docker Compose. Defina senha própria antes de pnpm db:up.
# Use estes mesmos dados na DATABASE_URL local; não alteram o banco do EasyPanel.
DB_NAME=atendefarma_dev
DB_USER=dev
DB_PASSWORD=
DB_PORT=5434

# Chave AES: 32 bytes em base64. Guardar backup; não trocar após salvar dados.
# Gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Evolution API — instalação existente; URL base sem /manager.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
# Opcional: segundo número na mesma Evolution; configure seu próprio prompt em Chatbot IA.
# Histórico, pausa humana e follow-ups permanecem separados por instância e cliente.
EVOLUTION_SECOND_INSTANCE_NAME=
# Opcional: terceiro número na mesma Evolution; também pode ser salvo em Configurações.
# Tem chatbot, histórico, pausa humana e follow-ups próprios.
EVOLUTION_THIRD_INSTANCE_NAME=

# Segredo exclusivo para autenticar o webhook (mínimo de 32 caracteres aleatórios).
# Enviar o mesmo valor no header x-webhook-secret do webhook da Evolution.
EVOLUTION_WEBHOOK_SECRET=

# Redis do Atende AI: redis://default:SENHA@HOST:6379/0 (rediss:// para TLS).
REDIS_URL=

# Processador contínuo: habilitar no serviço Next.js do EasyPanel e implantar.
# Não habilitar localmente com credenciais da produção.
ATENDEIA_WORKER_ENABLED=false
# Também pode ser ativado/desativado em Configurações pelo super administrador.
AI_ENABLED=false
# Follow-ups: configure pela página Follow-ups automáticos (salvamento criptografado).
# Login por e-mail e senha com sessão individual. Ativar somente após provisionamento e validação.
AUTH_LOGIN_ENABLED=false
# Origem HTTPS exata, sem barra final. Desenvolvimento: http://127.0.0.1:8002
AUTH_ORIGIN=
# Só confiar em X-Forwarded-For quando o proxy controlado sobrescreve o cabeçalho.
# 0 ignora o cabeçalho; 1 a 5 indica saltos confiáveis, contados da direita.
AUTH_TRUST_PROXY_HOPS=0
# Provisionamento MANUAL do primeiro administrador: usar só na execução do script.
# O arquivo do convite deve ficar em pasta privada fora do checkout (/tmp no container).
# PROVISIONAR_NOME=
# PROVISIONAR_EMAIL=
# PROVISIONAR_ARQUIVO=
# Use true somente para obter a etapa segura de uma falha, nunca detalhes do banco.
# PROVISIONAR_DIAGNOSTICO=false
# Use true somente para reemitir convite do proprietário inativo, sem passkey e com o mesmo e-mail.
# PROVISIONAR_REINICIAR_PROPRIETARIO=false
# FOLLOW_UP_CONFIG é JSON validado, com revisão gerada pelo servidor; não preencher manualmente.
# FOLLOW_UP_SECOND_CONFIG guarda os follow-ups do segundo chip; editar somente pelo painel.
# FOLLOW_UP_THIRD_CONFIG guarda os follow-ups do terceiro chip; editar somente pelo painel.

# Reserva por pedido, de 1 a 120 minutos.
FARMACIA_RESERVA_MINUTOS=15
# Chave Pix comercial da instalação, enviada somente quando o cliente escolhe Pix.
FARMACIA_PIX_CHAVE=
# Nome do recebedor para conferência no aplicativo do banco (opcional).
FARMACIA_PIX_RECEBEDOR=
# Use Redis exclusivo desta instalação, com AOF e noeviction.
REDIS_PASSWORD=
REDIS_PORT=6381
