{
  "name": "atendeai-farmacia",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8002",
    "build": "next build",
    "build:provisionamento": "esbuild scripts/provisionar-proprietario.ts --bundle --platform=node --format=cjs --target=node24 --outfile=.next/provisionar-proprietario.cjs",
    "start": "next start --hostname 127.0.0.1 --port 8002",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:node && pnpm test:ui",
    "test:node": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:ui": "vitest run --config config/vitest.config.mts",
    "lint": "eslint .",
    "test:compliance": "node tests/check-compliance.test.mjs",
    "compliance": "node scripts/check-compliance.mjs",
    "map": "node scripts/project-map.mjs --out docs/PROJECT_MAP.md",
    "docs:check": "node scripts/docs-check.mjs",
    "ai-marks": "node scripts/remove-ai-marks.mjs --check --dir docs",
    "lixo": "node scripts/limpar-lixo-raiz.mjs",
    "db:up": "docker compose up -d",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "verificar": "pnpm lint && pnpm typecheck && pnpm compliance && pnpm test:compliance && pnpm test && pnpm docs:check",
    "prepare": "node scripts/ativar-hooks.mjs",
    "db:generate": "drizzle-kit generate --config=config/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "ioredis": "^6.0.0",
    "next": "^16.0.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "packageManager": "pnpm@11.19.0"
}
