# ATENDE AI FARMACIA — variaveis do servico da aplicacao no EasyPanel.
# Modelo: preencha os campos vazios antes de implantar.
# Este arquivo configura conexoes; nao cria PostgreSQL, Redis ou Evolution.
# No EasyPanel, porta interna do servico: 3000.

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# DOMINIO PUBLICO — mesma URL HTTPS, sem barra final nos dois campos.
# Exemplo: https://farmacia.seudominio.com.br
APP_URL=
AUTH_ORIGIN=

# POSTGRESQL — dados persistentes: estoque, clientes, mensagens e pedidos.
# Use a URL interna fornecida pelo servico PostgreSQL desta farmacia.
# Formato: postgresql://USUARIO:SENHA_CODIFICADA@HOST_INTERNO:5432/BANCO
# Caracteres especiais na senha da URL precisam de percent-encoding.
DATABASE_URL=

# REDIS — contexto recente do agente, fila e controle de processamento.
# Use Redis exclusivo da farmacia, com volume persistente, AOF e noeviction.
# Formato: redis://default:SENHA_CODIFICADA@HOST_INTERNO:6379/0
# Se o provedor exigir TLS, use rediss://.
REDIS_URL=

# OPENAI — chave privada de API e ID de modelo disponivel na sua conta.
# O modelo deve suportar Responses API e function calling com schema estrito.
OPENAI_API_KEY=
OPENAI_MODEL=

# EVOLUTION API — URL base, sem /manager, e chave da sua instalacao.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Nome exato da instancia conectada ao WhatsApp desta farmacia.
EVOLUTION_INSTANCE_NAME=atendeai-farmacia
# Gere um segredo aleatorio de pelo menos 32 caracteres.
# Configure o mesmo valor no header x-webhook-secret da Evolution.
EVOLUTION_WEBHOOK_SECRET=
# Webhook: https://SEU_DOMINIO/api/webhooks/evolution
# Eventos: MESSAGES_UPSERT, MESSAGES_UPDATE, CONNECTION_UPDATE.

# CRIPTOGRAFIA — chave de 32 bytes em base64, exclusiva desta instalacao.
# Gere uma vez: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Guarde backup. Nao troque depois de salvar configuracoes criptografadas.
SETTINGS_ENCRYPTION_KEY=

# ATIVACAO — primeiro provisione o administrador conforme docs/seguranca-login.md.
# Depois altere AUTH_LOGIN_ENABLED para true.
AUTH_LOGIN_ENABLED=false
# Ative os dois abaixo apos configurar credenciais, webhook e chatbot da instancia.
AI_ENABLED=false
ATENDEIA_WORKER_ENABLED=false

# Ajuste apenas se o proxy controlado sobrescrever X-Forwarded-For.
AUTH_TRUST_PROXY_HOPS=0
FARMACIA_RESERVA_MINUTOS=15

# Configuracoes salvas pelo painel prevalecem sobre as variaveis de integracao.
# Se alterar uma integracao aqui e ela nao mudar, confira Configuracoes no painel.
